FROM node:20-slim AS deps

WORKDIR /app/web-app

COPY web-app/package.json web-app/package-lock.json ./
RUN npm ci

FROM node:20-slim AS builder

WORKDIR /app/web-app

ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL
ARG NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
ARG NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
ARG NEXT_PUBLIC_DODO_MONTHLY_PRODUCT_ID
ARG NEXT_PUBLIC_DODO_ANNUAL_PRODUCT_ID

ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_URL
ENV NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
ENV NEXT_PUBLIC_DODO_MONTHLY_PRODUCT_ID=$NEXT_PUBLIC_DODO_MONTHLY_PRODUCT_ID
ENV NEXT_PUBLIC_DODO_ANNUAL_PRODUCT_ID=$NEXT_PUBLIC_DODO_ANNUAL_PRODUCT_ID

COPY --from=deps /app/web-app/node_modules ./node_modules
COPY web-app ./
COPY data /app/data
COPY projects /app/projects
RUN npm run build

FROM node:20-slim AS runner

WORKDIR /app/web-app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder /app/web-app/public ./public
COPY --from=builder /app/web-app/.next/standalone ./
COPY --from=builder /app/web-app/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
